# JD TABLE (FULL)
table_data = [
    ["Category", "JD Expectation", "Rating", "Evidence / Notes"],
    ["Power BI Development", "Design dashboards", "Expert", "5 years across NatWest, Hammerson, AMEX"],
    ["DAX & Data Modeling", "Optimize DAX", "Expert", "Built measures across projects"],
    ["Power Query & ETL", "ETL from sources", "Expert", "On-prem + cloud"],
    ["Data Visualization", "Business dashboards", "Expert", "Charts and reports"],
