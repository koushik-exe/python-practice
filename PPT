# =====================================================
# SLIDE 1 — FULL CONTENT
# =====================================================
slide = prs.slides.add_slide(prs.slide_layouts[6])

# HEADER
shape = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(0), Inches(13.3), Inches(0.6))
shape.fill.solid()
shape.fill.fore_color.rgb = BLUE_DARK
tf = shape.text_frame
