    ["Governance", "Security policies", "Practitioner", "Role-based access"]
]

rows, cols = len(table_data), len(table_data[0])
table = slide.shapes.add_table(rows, cols, Inches(0.3), Inches(4.5), Inches(12.5), Inches(2.5)).table

for i in range(rows):
    for j in range(cols):
        cell = table.cell(i, j)
        cell.text = table_data[i][j]

        if i == 0:
            cell.fill.solid()
            cell.fill.fore_color.rgb = BLUE_DARK
            for p in cell.text_frame.paragraphs:
